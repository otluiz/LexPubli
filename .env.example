# LexPubli — copie para .env (não versionado) e preencha.

# --- Django/Wagtail ---
LEXPUBLI_DEBUG=0
# python -c "import secrets; print(secrets.token_urlsafe(50))"
LEXPUBLI_SECRET_KEY=
# "web" = o webhook chamado de dentro da rede do compose (changedetection.io)
LEXPUBLI_ALLOWED_HOSTS=localhost,127.0.0.1,web
LEXPUBLI_CSRF_TRUSTED_ORIGINS=http://localhost:8190
# URL pública do portal (links nos eventos, sitemap, e-mails do admin)
LEXPUBLI_BASE_URL=http://localhost:8190
# Caminho do painel (evite /admin/)
LEXPUBLI_ADMIN_PATH=painel/
# 1 quando houver HTTPS na frente (liga HSTS, cookies seguros, redirect)
LEXPUBLI_HTTPS=0
LEXPUBLI_PORT=8190

# --- Banco (compose) ---
POSTGRES_PASSWORD=

# --- Broker próprio (ADR-0005 §2a) ---
# O LexPubli NÃO usa o broker do LexLearn. Senhas só com [A-Za-z0-9] (vão
# dentro de URLs amqp://):
#   python -c "import secrets; print(secrets.token_hex(24))"
# Administrador: só gestão (UI em 127.0.0.1:15673) e o broker-init.
RABBITMQ_DEFAULT_USER=lexpubli-admin
RABBITMQ_DEFAULT_PASS=
# Usuário do worker (só publica em lexpubli.events). O compose monta a
# LEXPUBLI_RABBITMQ_URL do worker com ela.
BROKER_LEXPUBLI_PASSWORD=
# Usuário do LexCorpus (consome a fila dele, publica as respostas). Passe a
# mesma senha ao LexCorpus: LEXPUBLI_RABBIT_URL=
#   amqp://lexcorpus:<senha>@lexpubli-rabbitmq:5672/lexpubli
BROKER_LEXCORPUS_PASSWORD=

# --- Integração ---
LEXPUBLI_EXCHANGE=lexpubli.events
# Token do webhook do changedetection.io. Vazio = webhook desligado.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
LEXPUBLI_WEBHOOK_TOKEN=
